# Mission 18 settings template (do not store real credentials in Git)
# Start from project root. No services are exposed to the network by default.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8518
API_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./.local/movie.db

# Actual pinned local model: prefetch only with scripts/download_model.py
MODEL_BACKEND=transformers
MODEL_ID=daekeun-ml/koelectra-small-v3-nsmc
MODEL_REVISION=d1c0233fc013ae8bd879d7b61f2bec69aa3af4c9
MODEL_PATH=.local/models/koelectra-small-v3-nsmc
MAX_TOKENS=192

# G6 safety modes:
# - loopback (DEFAULT): mutations only from local loopback clients
# - read_only: all movie/review creates/deletes are rejected
# - token: each POST/DELETE requires Authorization: Bearer <server-secret>
# PUBLIC_DEPLOYMENT=true forbids loopback policy and SQLite database; requires
# a managed PostgreSQL URL and explicit https:// Streamlit CORS allowlist.
PUBLIC_DEPLOYMENT=false
WRITE_POLICY=loopback
CORS_ALLOW_ORIGINS=http://127.0.0.1:8518
# API_WRITE_TOKEN=<generated with: python -c 'import secrets; print(secrets.token_urlsafe(48))'>

# Public Streamlit must remain read-only until real visitor authentication exists.
FRONTEND_READ_ONLY=false
# DO NOT turn off public UI read-only merely because server possesses bearer secret.
