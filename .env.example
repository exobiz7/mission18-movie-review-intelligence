# Mission18 environment example (contract only; no API implementation until G2)
# Start services from the project root. Never commit a real .env/secrets.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8518
API_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./.local/movie.db
# Phase 3 model research/benchmark will select and lock these values.
MODEL_BACKEND=unconfigured
MODEL_ID=
MODEL_REVISION=
MODEL_PATH=
MAX_TOKENS=192
# Public deployment must set an explicit CORS allowlist and write controls.
CORS_ALLOW_ORIGINS=http://127.0.0.1:8518
